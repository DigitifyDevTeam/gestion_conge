# Production (rh.digitify.fr) — copy to .env.production (or run: npm run env:prod)
APP_ENV=production

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-generate-with-get_random_secret_key
DJANGO_ALLOWED_HOSTS=rh.digitify.fr,localhost,127.0.0.1
FRONTEND_URL=https://rh.digitify.fr
CSRF_TRUSTED_ORIGINS=https://rh.digitify.fr
GUNICORN_BIND=127.0.0.1:8001

DB_NAME=rh
DB_USER=rh
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=3306

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-gmail-app-password
# Generate at: https://myaccount.google.com/apppasswords (2FA required)
DEFAULT_FROM_EMAIL=Gestion de congé <your@gmail.com>
