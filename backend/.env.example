# Copy to backend/.env and fill real values. Never commit .env.

FRONTEND_URL=http://localhost:8080

# SMTP (Gmail example) — required for OTP, invitations, and action notifications
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=your@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=HolidayHub <noreply@yourdomain.com>

