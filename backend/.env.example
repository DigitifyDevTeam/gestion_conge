# Environment setup — secrets stay in gitignored files.

# 1. Copy examples (first time only):
#    cp backend/.env.local.example      backend/.env.local
#    cp backend/.env.production.example backend/.env.production
#    cp backend/.env.active.example     backend/.env.active

# 2. Switch environment:
#    npm run env:local   → local dev (MySQL root/root, DEBUG=1)
#    npm run env:prod    → production VPS settings

# Active file: backend/.env.active  (contains: local | production)
# Loaded file: backend/.env.local or backend/.env.production
