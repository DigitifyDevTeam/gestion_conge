# Copy to backend/.env and fill real values. Never commit .env.

# --- Local development ---
# DJANGO_DEBUG=1
# DJANGO_SECRET_KEY=change-me
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# FRONTEND_URL=http://localhost:5175

# --- Production (rh.digitify.fr) ---
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-generate-with-get_random_secret_key
DJANGO_ALLOWED_HOSTS=rh.digitify.fr,localhost,127.0.0.1
FRONTEND_URL=https://rh.digitify.fr
CSRF_TRUSTED_ORIGINS=https://rh.digitify.fr

# Gunicorn (production VPS — port 8000 is taken by another app)
GUNICORN_BIND=127.0.0.1:8001

# MySQL (use localhost when DB is on the same VPS)
DB_NAME=rh
DB_USER=rh
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=3306

# SMTP — required for OTP, invitations, and action notifications
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Gestion de congé <noreply@yourdomain.com>

# Monthly comptable report (cron on the 1st of each month):
# python manage.py send_monthly_leave_report
