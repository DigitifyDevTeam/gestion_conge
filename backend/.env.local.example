# Local development — copy to .env.local (or run: npm run env:local)
APP_ENV=local

DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
FRONTEND_URL=http://localhost:5175

# Local MySQL (XAMPP / WAMP / Docker / native)
DB_NAME=holidays_app
DB_USER=root
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=3306

# Emails print in terminal during dev
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
